#!/usr/bin/env python3
"""
Hermes Agent CLI launcher.

This wrapper should behave like the installed `hermes` command, including
subcommands such as `gateway`, `cron`, and `doctor`.
"""

if __name__ == "__main__":
    import os
    import sys

    # Re-exec with the repo venv's interpreter when we were launched with a
    # different one (e.g. the system python via `./hermes` outside an
    # activated venv) — hermes deps live only in .venv.
    repo_dir = os.path.dirname(os.path.abspath(__file__))
    venv_python = os.path.join(repo_dir, ".venv", "bin", "python3")
    if (
        os.path.exists(venv_python)
        and os.path.realpath(sys.executable) != os.path.realpath(venv_python)
        and not os.environ.get("_HERMES_LAUNCHER_REEXEC")
    ):
        os.environ["_HERMES_LAUNCHER_REEXEC"] = "1"
        os.execv(venv_python, [venv_python, os.path.abspath(__file__)] + sys.argv[1:])

    from hermes_cli.main import main
    main()
